# Application
ENVIRONMENT=production
LOG_LEVEL=info
SECRET_KEY=replace-with-a-64-character-random-hex-in-prod

# Database (PostgreSQL)
POSTGRES_USER=sa_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=ingestion_db
DATABASE_URL=postgresql://sa_user:replace_with_strong_password@localhost:5432/ingestion_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# Networking & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000
FRONTEND_PORT=3000
